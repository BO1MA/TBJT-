{
  "name": "the-boy-with-the-jagged-tongue",
  "version": "1.0.4",
  "description": "FMV Interactive Game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [
    "fmv",
    "interactive-fiction",
    "electron"
  ],
  "author": "ASHMODEL",
  "license": "ISC",
  "build": {
    "appId": "com.ashmudel.tbjt",
    "productName": "The Boy with the Jagged Tongue",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "uninstallDisplayName": "The Boy with the Jagged Tongue",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "allowScripts": {
    "electron@30.5.1": true
  }
}
